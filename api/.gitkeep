package api

import "net/http"

type Midleware func(http.Handler) http.Handler

func CreateStack(middlewares ...Middleware) http.Handler {
	return func(next http.Handler) http.Handler {
		for i := len(middlewares) - 1; i >= 0; i-- {
			middleware = middlewares[i]
			next = middleware(next)
		}
		return next
	}
}
